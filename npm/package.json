{
  "name": "dith",
  "version": "0.5.0",
  "description": "Deterministic dithering, procedural dither art and vector halftones for browsers and Node: the dith Rust engine in WebAssembly, with a worker pool and generated types.",
  "keywords": [
    "dither",
    "dithering",
    "halftone",
    "image",
    "pixel-art",
    "risograph",
    "wasm",
    "webassembly",
    "worker"
  ],
  "homepage": "https://github.com/lassejlv/dith#readme",
  "bugs": "https://github.com/lassejlv/dith/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lassejlv/dith.git",
    "directory": "npm"
  },
  "files": [
    "dist",
    "wasm/dith_bg.wasm"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    },
    "./wasm/dith_bg.wasm": "./wasm/dith_bg.wasm",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:wasm": "../scripts/build-wasm.sh",
    "gen": "node scripts/gen-schema.mjs",
    "build": "node scripts/gen-schema.mjs && vp pack",
    "check": "vp check",
    "test": "vp test",
    "bench": "node bench/run.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "playwright": "^1.65.1",
    "vite-plus": "1.8.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8001",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=20"
  }
}
